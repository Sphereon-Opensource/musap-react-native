project 'musap-react-native.xcodeproj'
workspace 'musap-react-native.xcworkspace'
#source 'https://github.com/CocoaPods/Specs.git'

# Define path to RN
react_native_path = '../node_modules/react-native'

# Require the standard RN scripts (Only this one is needed in 0.79+)
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

platform :ios, '16.0'
prepare_react_native_project!

target 'musap-react-native' do
  # Removed use_native_modules! (Not needed/Available in CLI v15 for libraries)

  use_react_native!(
    :path => react_native_path,
    :hermes_enabled => false,
    :fabric_enabled => false,
  )

  # Swift pods with modular headers
  pod 'YubiKit', '~> 4.4.0', :modular_headers => true
  pod 'musap-ios', :path => '../../musap-native', :modular_headers => true

  # Dependencies are managed by the Podspec, but we keep this post_install
  # to force the correct compiler settings for the library build.

  post_install do |installer|
    # 1. Helper to find React Native path for dependencies
    installer.pods_project.targets.each do |target|
        target.build_configurations.each do |config|
          if config.build_settings['REACT_NATIVE_PATH'].nil? || config.build_settings['REACT_NATIVE_PATH'].empty?
            config.build_settings['REACT_NATIVE_PATH'] = "#{Pod::Config.instance.installation_root.to_s}/../node_modules/react-native"
          end
        end
    end

    # 2. Fix Build Settings for ALL targets (Force iOS 16.0 / C++20)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
         # Force iOS 16.0 (Required for Nitro/C++ Interop)
         config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'

         # Enforce C++20 (Required for React Native 0.79 / Yoga)
         config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'

         # Allow non-modular includes (Fixes Yoga/React header visibility issues)
         config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

         # IMPORTANT: Do NOT enable Swift C++ interop for musap-ios or YubiKit
         # We use Objective-C++ bridge pattern instead
         # Only enable for musap-react-native if it has Swift files needing C++ interop
         unless target.name == 'musap-ios' || target.name == 'YubiKit'
           # Enable C++ Interop for Swift (Required for Nitro Modules)
           # REMOVED: We don't need this anymore with the Objective-C++ bridge pattern
           # config.build_settings['SWIFT_OBJC_INTEROP_MODE'] = 'objcxx'
         end

         # Disable strict module verification (Fixes "EmitSwiftModule" failures)
         config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'

         # Disable sandboxing (Fixes "tasks in Copy Headers are delayed" warning)
         config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'

         # Disable library evolution for Swift pods
         if target.name == 'musap-ios' || target.name == 'YubiKit'
           config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
         end
      end
    end
  end

end
